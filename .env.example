# 官网当前接口。默认 current；legacy 可保留两个原项目的旧接口做离线兼容。
CREDITCHINA_API_MODE=current
CREDITCHINA_SITE_URL=https://www.creditchina.gov.cn
CREDITCHINA_API_BASE=https://public.creditchina.gov.cn/private-api
CREDITCHINA_SEARCH_PATH=/catalogSearchHome
CREDITCHINA_DETAIL_PATH=/getTyshxydmDetailsContent
CREDITCHINA_CATEGORY_PATH=/typeSourceSearch
CREDITCHINA_REQUEST_INTERVAL_SECONDS=1
CREDITCHINA_CAPTCHA_TIMEOUT=300
CREDITCHINA_CAPTCHA_AUTO_ATTEMPTS=3
CREDITCHINA_CAPTCHA_SOLVER_TIMEOUT=30
CREDITCHINA_OUTPUT=output
CREDITCHINA_API_STATE=output/creditchina_api.sqlite3
CREDITCHINA_MONITOR_COMPANIES=monitor_companies.txt

# 网页 API 令牌。设置后，除 /api/v1/health 外所有接口都要求
# X-API-Token 请求头（或 token 查询参数）携带相同的值；
# 前端需同步设置 NEXT_PUBLIC_CRAWLER_API_TOKEN。留空则不启用鉴权。
CREDITCHINA_API_TOKEN=
# 允许跨域访问 API 的前端来源，逗号分隔。默认为本机 3000 端口。
# CREDITCHINA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 验证码自动识别。网页后台不会回退到弹图或终端人工输入。
JFBYM_TOKEN=
JFBYM_TYPE=10103

# 上海住建信用分接口。默认直连；只有明确需要时才填写代理。
SH_ZJW_TIMEOUT=15
SH_ZJW_PROXY=

# 仅 requests/urllib 模式可选：固定 Cookie。不要把真实 Cookie 提交到版本库。
CREDITCHINA_COOKIE=

# 仅支持静态代理，不查询任何代理数据库。
# JSON 数组示例：["http://127.0.0.1:7890", "http=127.0.0.1:8080;https=127.0.0.1:8081"]
CREDITCHINA_PROXIES=[]

# 快代理私密代理（真实凭据仅写入 .env.local，且不要提交到版本库）。
KDL_DPS_USERNAME=
KDL_DPS_PASSWORD=
KDL_DPS_SECRET_ID=
# 二选一：SecretKey 使用 HMAC-SHA1；SecretToken 使用 token 鉴权。
KDL_DPS_SECRET_KEY=
KDL_DPS_SECRET_TOKEN=
KDL_DPS_API_URL=
KDL_DPS_TIMEOUT=10
KDL_MAX_PROXY_REPLACEMENTS_PER_TASK=20
KDL_PROXY_REPLACEMENT_COOLDOWN_SECONDS=1

# MySQL（仅 --write-db、--db-source 或 --init-db 时使用）
CREDITCHINA_DB_HOST=127.0.0.1
CREDITCHINA_DB_PORT=3306
CREDITCHINA_DB_USER=root
CREDITCHINA_DB_PASSWORD=
CREDITCHINA_DB_NAME=creditchina
CREDITCHINA_DB_CHARSET=utf8mb4
